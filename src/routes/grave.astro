---
// Grave-side page: what a visitor sees after scanning the QR code or tapping the NFC tag.
// Deliberately tiny: system font stack, no JavaScript, audio loads only when pressed.
import MiniLayout from '../layouts/MiniLayout.astro';
import { loadMemorial, getMemorials } from '../lib/memorial';
import { loc } from '../lib/i18n';
import { lifeYear } from '../lib/format';
import { href, asset } from '../lib/url';
import { features } from '../lib/site';

export async function getStaticPaths() {
  return (await getMemorials()).map((m) => ({ params: { slug: m.id } }));
}
const { slug } = Astro.params;
const data = await loadMemorial(slug!);
const m = data.memorial.data;
const born = lifeYear(m.birth.date, 'fa', data.calendar);
const died = m.death ? lifeYear(m.death.date, 'fa', data.calendar) : undefined;
const hero = m.heroImageId ? data.galleryById.get(m.heroImageId) : undefined;
const audio = data.keepsakes.find((k) => (k.data.kind === 'audio' || k.data.kind === 'music') && k.data.audioSrc);
const place = m.death?.place ? loc(m.death.place, 'fa') : undefined;
---

<MiniLayout path={`g/${slug}`} title={`${loc(m.name, 'fa')} | یادبود`} description={loc(m.tagline, 'fa')} sample={m.sample}>
  <main>
    {hero && <img class="portrait" src={asset(hero.data.src)} alt={loc(hero.data.alt, 'fa')} width={hero.data.width} height={hero.data.height} decoding="async" fetchpriority="high" />}
    <p class="eyebrow">یادبود</p>
    <h1>{loc(m.name, 'fa')}</h1>
    <p class="years">{born.primary}{died && <> – {died.primary}</>}</p>
    <p class="tagline">{loc(m.tagline, 'fa')}</p>

    {
      audio && (
        <section class="audio" aria-label="صدا">
          <p>{loc(audio.data.title, 'fa')}</p>
          <audio controls preload="none" src={asset(audio.data.audioSrc!)}></audio>
        </section>
      )
    }

    <nav class="links" aria-label="ادامه">
      <a class="btn solid" href={href(slug!)}>خواندن داستان کامل</a>
      {features.memories && data.has.memories && <a class="btn" href={href(`${slug}/memories`)}>خاطره‌ها</a>}
      {features.memories && data.has.memories && <a class="btn" href={href('submit-memory')}>ثبت یک خاطره</a>}
    </nav>
    {place && <p class="place">{place}</p>}
  </main>
</MiniLayout>

<style>
  main { max-inline-size: 30rem; margin: 0 auto; padding: 2rem 1.25rem 3rem; text-align: center; }
  .portrait { display: block; inline-size: min(60%, 14rem); block-size: auto; margin: 0 auto 1.25rem; border-radius: 50%; aspect-ratio: 1; object-fit: cover; }
  .eyebrow { margin: 0; color: var(--accent); font-weight: 700; letter-spacing: 0.04em; }
  h1 { font-size: clamp(2rem, 9vw, 2.8rem); line-height: 1.3; margin: 0.2rem 0; }
  .years { font-size: 1.25rem; color: var(--soft); margin: 0; }
  .tagline { font-size: 1.15rem; margin: 1.25rem 0 1.5rem; }
  .audio { margin-block: 1.5rem; padding-block: 1rem; border-block: 1px solid var(--rule); }
  .audio p { margin: 0 0 0.5rem; color: var(--soft); }
  audio { inline-size: 100%; }
  .links { display: grid; gap: 0.75rem; margin-block-start: 1.5rem; }
  .place { color: var(--soft); margin-block-start: 2rem; font-size: 0.9rem; }
</style>
