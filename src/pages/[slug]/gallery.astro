---
import MemorialLayout from '../../layouts/MemorialLayout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { loadMemorial, memorialPathsWith } from '../../lib/memorial';

export async function getStaticPaths() {
  return memorialPathsWith('gallery');
}
const { slug } = Astro.params;
const data = await loadMemorial(slug!);
const sorted = [...data.gallery].sort((a, b) => (a.data.date ?? '9999').localeCompare(b.data.date ?? '9999'));
---

<MemorialLayout
  data={data}
  section="gallery"
  title="گالری"
  description="تصویرهای مرتبط با زندگی، همراه با شرح، تاریخ، پدیدآورنده، منبع و وضعیت مجوز."
  lead="برای هر تصویر، منبع و وضعیت مجوز ثبت شده است. برای دیدن تصویر بزرگ‌تر روی آن بزنید."
  wide
>
  {
    sorted.length > 0 ? (
      <PhotoGallery items={sorted} />
    ) : (
      <div class="empty">
        <p><strong>هنوز تصویری منتشر نشده است.</strong></p>
        <p>
          تصویرها فقط وقتی اضافه می‌شوند که منبع و وضعیت مجوزشان مشخص باشد. نحوهٔ افزودن تصویر در راهنمای محتوا (CONTENT-GUIDE.md) آمده است.
        </p>
      </div>
    )
  }
</MemorialLayout>
